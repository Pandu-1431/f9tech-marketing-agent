# ---------- App ----------
# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Leave empty to use the built-in embedded database (./.data/pglite) — no setup.
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432)
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------- File storage (logos, posters, videos) ----------
# local = ./.data/uploads (dev). s3 = Supabase Storage or Cloudflare R2.
STORAGE_DRIVER=local
# Supabase Storage (S3 protocol): Storage -> Settings -> S3 Connection -> create access key.
# Create a PUBLIC bucket named "media" first.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<project-region e.g. ap-south-1>
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# true = run AI jobs inside the web server right after each request (dev / single server).
# false = run `npm run worker` separately (needs a real Postgres DATABASE_URL).
AGENT_INLINE_JOBS=true

# ---------- Free trial (Phase 1) ----------
# New workspaces get this many free days with all tools.
AGENT_TRIAL_DAYS=21
AGENT_MAX_BRANDS=4
AGENT_MAX_POSTS_PER_CAMPAIGN=30
AGENT_MONTHLY_TEXT_GENERATIONS=600
AGENT_MONTHLY_IMAGE_GENERATIONS=200
AGENT_MONTHLY_VIDEOS=30

# ---------- AI text providers (tried in this order) ----------
# Options: gemini, groq, openrouter, local, fake (fake = demo without any key)
AGENT_TEXT_CHAIN=gemini,groq

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# One model or a list, tried in order (busy / over-limit / slow models are skipped automatically).
# gemini-flash-lite-latest answers in ~6 s on the free tier; gemini-flash-latest is smarter but often busy.
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest
GEMINI_DAILY_LIMIT=200

# Groq key (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DAILY_LIMIT=500

# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_DAILY_LIMIT=50

# Local model via Ollama / LM Studio on an office Mac
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b

# ---------- AI image providers (tried in this order) ----------
# Options: cloudflare, huggingface, pollinations, fake (fake = offline brand-colour backgrounds)
AGENT_IMAGE_CHAIN=cloudflare,huggingface,fake

# Cloudflare Workers AI (free daily allowance): dash.cloudflare.com -> AI -> Workers AI -> Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Hugging Face (free monthly credits): huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---------- Voice for reel videos (tried in this order) ----------
# Options: cloudflare (MeloTTS, uses the Cloudflare key above), piper (offline), silent
AGENT_VOICE_CHAIN=cloudflare,piper,silent
# Piper offline voice: pip install piper-tts, then download a voice, e.g.
#   https://github.com/rhasspy/piper/releases/download/v0.0.2/voice-en-us-lessac-medium.tar.gz
PIPER_MODEL=
PIPER_COMMAND=python3 -m piper

# Optional: a royalty-free music file for reels (mp3/wav). Empty = soft generated music bed.
AGENT_MUSIC_FILE=
# Optional: use your own ffmpeg instead of the bundled one.
FFMPEG_PATH=
