# ---------- App ----------
# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Leave empty to use the built-in embedded database (./.data/pglite) — no setup.
# Production: postgres://user:pass@host:5432/marketing_agent
DATABASE_URL=

# true = run AI jobs inside the web server right after each request (dev / single server).
# false = run `npm run worker` separately (needs a real Postgres DATABASE_URL).
AGENT_INLINE_JOBS=true

# ---------- Free plan limits (Phase 1) ----------
AGENT_MAX_BRANDS=4
AGENT_MAX_POSTS_PER_CAMPAIGN=30
AGENT_MONTHLY_TEXT_GENERATIONS=600

# ---------- AI text providers (tried in this order) ----------
# Options: gemini, groq, openrouter, local, fake (fake = demo without any key)
AGENT_TEXT_CHAIN=gemini,groq

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=200

# Groq key (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DAILY_LIMIT=500

# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_DAILY_LIMIT=50

# Local model via Ollama / LM Studio on an office Mac
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b
