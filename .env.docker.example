# Copy to .env.docker (never commit it). Database, job worker and APP_URL are set by docker-compose.yml.
SESSION_SECRET=            # openssl rand -base64 32

# Text AI (free keys): https://aistudio.google.com/apikey , https://console.groq.com/keys
AGENT_TEXT_CHAIN=gemini,groq
GEMINI_API_KEY=
GROQ_API_KEY=

# Images + voice (free daily allowance): Cloudflare Workers AI
AGENT_IMAGE_CHAIN=cloudflare,pollinations
AGENT_VOICE_CHAIN=cloudflare,groq,silent
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Files: local (kept in the Docker "uploads" volume) or s3 (Supabase Storage / R2)
STORAGE_DRIVER=local
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_PUBLIC_URL= S3_REGION=

# Optional: YouTube / Business Profile / Google Sheet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
